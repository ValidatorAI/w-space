<li class="account-bots-item">
  <div class="account-bots-item__header">
    <div class="account-bots-item__identity">
      <figure class="avatar account-bots-item__avatar" style="--avatar-size: 2.65em;">
        <%= avatar_tag bot, loading: :lazy %>
      </figure>

      <div class="account-bots-item__meta">
        <div class="account-bots-item__name"><%= bot.name %></div>
        <div class="account-bots-item__sub">Webhook bot</div>
      </div>
    </div>

    <div class="account-bots-item__actions">
      <%= link_to edit_account_bot_path(bot, return_to: return_to), class: "action-btn action-btn--small", style: "view-transition-name: chat-bot-#{ bot.id }" do %>
        <%= image_tag "pencil.svg", aria: { hidden: "true" }, size: 14 %>
        <span>Edit</span>
      <% end %>
    </div>
  </div>

  <% unless return_to == "company_settings" %>
    <% bot.rooms.without_directs.ordered.each do |room| %>
      <fieldset class="account-bots-item__details">
        <legend class="account-bots-item__legend">
          <strong><%= room_display_name(room) %></strong>
        </legend>

        <% curl_text_line = "curl -d 'Hello!' #{room_bot_messages_url(room, bot.bot_key)}" %>
        <div class="account-bots-item__command-row">
          <%= image_tag "messages-outlined.svg", aria: { hidden: "true" }, size: 18, class: "colorize--black" %>
          <div class="flex-item-grow">
            <input type="text" class="input full-width" value="<%= curl_text_line %>" aria-label="curl command for posting messages" readonly>
          </div>
          <button type="button" class="action-btn action-btn--small" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="<%= curl_text_line %>">
            <%= image_tag "copy-paste.svg", aria: { hidden: "true" }, size: 16 %>
            <span class="for-screen-reader">Copy message command</span>
          </button>
        </div>

        <% curl_upload_line = %[curl -F "attachment=@/path/to/file" #{room_bot_messages_url(room, bot.bot_key)}] %>
        <div class="account-bots-item__command-row">
          <%= image_tag "attachment.svg", aria: { hidden: "true" }, size: 18, class: "colorize--black" %>
          <div class="flex-item-grow">
            <input type="text" class="input full-width" value="<%= curl_upload_line %>" aria-label="curl command for posting attachments" readonly>
          </div>
          <button type="button" class="action-btn action-btn--small" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="<%= curl_upload_line %>">
            <%= image_tag "copy-paste.svg", aria: { hidden: "true" }, size: 16 %>
            <span class="for-screen-reader">Copy attachment command</span>
          </button>
        </div>
      </fieldset>
    <% end %>
  <% end %>
</li>
