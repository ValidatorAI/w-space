<% @page_title = "#{@project.display_name} All-Hands Hub" %>
<% @body_class = "room-shell" %>

<% content_for :nav do %>
  <div class="room-shell-topbar" aria-label="Workspace header">
    <div class="room-shell-topbar__brand">
      <span class="room-shell-topbar__brand-symbol" aria-hidden="true">W</span>
      <span>PWR <strong>WORK</strong></span>
    </div>

    <div class="room-shell-topbar__workspace">
      <span class="room-shell-topbar__dot" aria-hidden="true"></span>
      <span>Workspace</span>
    </div>

    <div class="room-shell-topbar__search-wrap" data-controller="search-dropdown" data-action="click@window->search-dropdown#closeOnOutside keydown.esc->search-dropdown#close">
      <div class="room-shell-topbar__search-bar" aria-label="Search or ask W">
        <span class="room-shell-topbar__search-form-icon" aria-hidden="true">⌕</span>
        <input
          type="search"
          class="room-shell-topbar__search-input"
          placeholder="Search or ask W"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search or ask W"
          data-search-dropdown-target="input"
        >
        <kbd>⌘K</kbd>
      </div>

      <div id="room-search-panel" class="room-shell-topbar__search-panel hidden" data-search-dropdown-target="panel" role="dialog" aria-label="Search or ask W">
        <div class="room-shell-topbar__search-results" data-search-dropdown-target="results"></div>
        <div class="room-shell-topbar__search-actions">
          <a href="/searches" class="btn btn--ghost room-shell-topbar__ask-button">Ask from W</a>
        </div>
      </div>
    </div>

    <div class="room-shell-topbar__end">
      <span class="room-shell-topbar__dot" aria-hidden="true"></span>
      <span>Context updated <%= time_ago_in_words(Current.user.updated_at) %> ago</span>
      <%= avatar_tag(Current.user) %>
    </div>
  </div>
<% end %>

<div class="workspace-room workspace-room--context-hidden"
     data-controller="room-shell"
     data-action="click->room-shell#closeWorkspaceIfOpen">
  <aside id="workspace-navigation" class="workspace-room__workspace" data-room-shell-target="workspace" aria-label="Workspace navigation">
    <%= sidebar_turbo_frame_tag(src: user_sidebar_path) %>
  </aside>

  <main class="workspace-room__main" id="conversation" style="width: 80vw;">
    <%= turbo_stream_from @project, :all_hands %>

    <div id="message-area" class="message-area project-all-hands-area" data-controller="all-hands-notes">
      <div class="project-all-hands-content">
        <div class="all-hands-card" style="margin-bottom: 20px;">
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 12px;">
            <h3 class="all-hands-card-title" style="margin: 0;">Current Running Meetings</h3>
            <button type="button" class="btn btn--primary" onclick="document.getElementById('new-meeting-dialog').showModal();">New Meeting</button>
          </div>

          <% if @running_meetings.any? %>
            <div style="display: flex; flex-wrap: wrap; gap: 12px;">
              <% @running_meetings.each do |meeting| %>
                <%= link_to "Join #{meeting.title} meeting", meeting_path(id: meeting.id, role: "member"), class: "btn btn--primary", style: "display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-width: 180px;", data: { turbo: false } %>
              <% end %>
            </div>
          <% else %>
            <p style="font-size: 14px; color: var(--text-secondary); margin: 0;">No meetings are currently running for this project.</p>
          <% end %>
        </div>

        <dialog id="new-meeting-dialog" style="min-width: min(480px, 90vw); border: 1px solid rgba(148, 163, 184, 0.3); border-radius: 12px; padding: 0; background: #0f172a; color: white;">
          <%= form_with url: create_meeting_path, method: :post, local: true, html: { style: "padding: 20px;" } do |f| %>
            <%= hidden_field_tag :project_id, @project.id %>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <h3 style="margin: 0; font-size: 20px;">Create meeting</h3>
              <button type="button" onclick="document.getElementById('new-meeting-dialog').close();" aria-label="Close" style="background: transparent; border: 0; color: white; font-size: 20px; cursor: pointer;">×</button>
            </div>

            <label for="meeting-title" style="display: block; margin-bottom: 8px; font-size: 14px; color: #cbd5e1;">Meeting name</label>
            <%= text_field_tag "project_all_hands_meeting[title]", nil, id: "meeting-title", required: true, placeholder: "Daily standup", style: "width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid rgba(148, 163, 184, 0.4); background: rgba(15, 23, 42, 0.75); color: white; box-sizing: border-box; margin-bottom: 16px;" %>

            <div style="display: flex; justify-content: flex-end; gap: 8px;">
              <button type="button" class="btn btn--ghost" onclick="document.getElementById('new-meeting-dialog').close();">Cancel</button>
              <%= f.submit "Start meeting", class: "btn btn--primary" %>
            </div>
          <% end %>
        </dialog>

        <div class="all-hands-grid">
          <div class="all-hands-card">
            <h3 class="all-hands-card-title">✨ AI Summary &amp; Key Takeaways</h3>
            <% if @takeaways.any? %>
              <ul class="all-hands-bullet-list">
                <% @takeaways.each do |takeaway| %>
                  <li><strong><%= takeaway.category %>:</strong> <%= takeaway.content %></li>
                <% end %>
              </ul>
            <% else %>
              <p style="font-size: 13px; color: var(--text-secondary); margin: 0;">No active takeaways recorded for this project.</p>
            <% end %>
          </div>

          <%= render "users/projects/all_hands/action_items_card", action_items: @action_items, project: @project %>
        </div>

        <% if @decisions.any? %>
          <div class="all-hands-card">
            <h3 class="all-hands-card-title">Decisions Logged</h3>
            <% @decisions.each do |decision| %>
              <div class="all-hands-list-item all-hands-list-item--row">
                <div>
                  <div class="all-hands-item-title"><%= decision.title %></div>
                  <% dec_parts = [] %>
                  <% dec_parts << decision.basis if decision.basis.present? %>
                  <% dec_parts << "Impact: #{decision.impact}" if decision.impact.present? %>
                  <% if dec_parts.any? %>
                    <div class="all-hands-item-meta"><%= dec_parts.join(" • ") %></div>
                  <% end %>
                </div>
                <% if decision.badge.present? %>
                  <span class="all-hands-badge all-hands-badge--blue"><%= decision.badge %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="all-hands-card" style="text-align: center; padding: 48px 24px;">
            <h3 class="all-hands-card-title" style="justify-content: center; margin-bottom: 8px;">No Active All-Hands Items</h3>
            <p style="font-size: 14px; color: var(--text-secondary); margin: 0;">This project does not currently have any active takeaways, action items, or decisions.</p>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</div>
