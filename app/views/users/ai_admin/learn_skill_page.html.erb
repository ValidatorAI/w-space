<% @page_title = "AI Config - Learn Skill" %>
<% @body_class = "sidebar" %>

<% content_for :nav do %>
  <span class="btn btn--reversed btn--faux user-settings-nav__pill bg-black">Workspace</span>
  <h1 class="user-settings-nav__title txt-large">Learn Skill</h1>
<% end %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<div id="message-area" class="message-area">
  <div class="feed-container company-settings-feed">
    <div class="settings-container">
      <%= render "users/ai_admin/top_links", active_tab: :skills %>

      <section class="settings-card" aria-label="Learn skill form">
        <div class="settings-section-title settings-section-title--spread">
          <span>Learn Skill (Event Only)</span>
          <%= link_to "Back to skills", user_company_ai_admin_skills_page_path(user_id: "me"), class: "action-btn action-btn--small" %>
        </div>
        <p class="settings-section-copy">This sends a learning request event to OUTPUT_EVENTS_URL/W-bridge and does not change skills directly.</p>

        <%= form_with scope: :learn, url: user_company_ai_admin_skill_learn_path(user_id: "me"), class: "company-settings-form" do |form| %>
          <div class="form-row form-row--two">
            <div class="form-group">
              <label>Source kind</label>
              <%= form.select :source_kind,
                    options_for_select([
                      ["Local File", "local_file"],
                      ["Directory", "directory"],
                      ["URL", "url"],
                      ["Workflow Notes", "notes"]
                    ]),
                    {},
                    class: "input" %>
            </div>
            <div class="form-group">
              <label>Source reference</label>
              <%= form.text_field :source_reference, class: "input", placeholder: "path, URL, or short reference" %>
            </div>
          </div>

          <div class="form-row form-row--two">
            <div class="form-group">
              <label>Skill name hint</label>
              <%= form.text_field :skill_name, class: "input", placeholder: "Optional" %>
            </div>
            <div class="form-group">
              <label>Skill category hint</label>
              <%= form.text_field :skill_category, class: "input", placeholder: "Optional" %>
            </div>
          </div>

          <div class="form-group">
            <label>Anything else</label>
            <%= form.text_area :notes, rows: 5, class: "input", placeholder: "Describe the workflow, paste notes, or summarize what was done." %>
          </div>

          <div class="settings-row-actions">
            <%= form.submit "Send learn event", class: "action-btn primary" %>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>
