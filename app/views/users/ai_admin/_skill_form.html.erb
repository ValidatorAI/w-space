<%= form_with model: skill, url: form_url, method: form_method, class: "company-settings-form" do |form| %>
  <div class="form-row form-row--two">
    <div class="form-group">
      <label>Skill name</label>
      <%= form.text_field :name, class: "input", required: true %>
    </div>
    <div class="form-group">
      <label>Category</label>
      <%= form.text_field :category, class: "input" %>
    </div>
  </div>

  <div class="form-group">
    <label>Description</label>
    <%= form.text_area :description, rows: 2, class: "input" %>
  </div>

  <div class="form-group">
    <label>Skill text</label>
    <%= form.text_area :skill_text, rows: 4, class: "input" %>
  </div>

  <label class="private-toggle" style="border-top: none; padding-top: 0;">
    <%= form.check_box :add_by_default %>
    Add by default for new profiles
  </label>

  <div class="settings-row-actions">
    <%= form.submit submit_label, class: "action-btn primary" %>
  </div>
<% end %>
