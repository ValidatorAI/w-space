<% @page_title = "AI Config - MCPs" %>
<% @body_class = "room-shell" %>

<% content_for :nav do %>
  <div class="room-shell-topbar" aria-label="Workspace header">
    <div class="room-shell-topbar__brand">
      <span class="room-shell-topbar__brand-symbol" aria-hidden="true">W</span>
      <span>PWR <strong>WORK</strong></span>
    </div>

    <div class="room-shell-topbar__workspace">
      <span class="room-shell-topbar__dot" aria-hidden="true"></span>
      <span>Workspace</span>
    </div>

    <%= link_to searches_path, class: "btn room-shell-topbar__search", aria: { label: "Search or ask" } do %>
      <span aria-hidden="true">⌕</span>
      <span>Search or ask W</span>
      <kbd>⌘K</kbd>
    <% end %>

    <div class="room-shell-topbar__end">
      <span class="room-shell-topbar__dot" aria-hidden="true"></span>
      <span>Context updated <%= time_ago_in_words(Current.user.updated_at) %> ago</span>
      <%= avatar_tag(Current.user) %>
    </div>
  </div>
<% end %>

<div class="workspace-room workspace-room--context-hidden"
     data-controller="room-shell"
     data-action="click->room-shell#closeWorkspaceIfOpen">
  <aside id="workspace-navigation" class="workspace-room__workspace" data-room-shell-target="workspace" aria-label="Workspace navigation">
    <%= sidebar_turbo_frame_tag(src: user_sidebar_path) %>
  </aside>

  <main class="workspace-room__main" id="conversation" style="width: 80vw;">
    <div id="message-area" class="message-area">
  <div class="feed-container company-settings-feed">
    <div class="settings-container">
      <%= render "users/ai_admin/top_links", active_tab: :mcps %>

      <section class="settings-card" aria-label="MCP settings">
        <div class="settings-section-title settings-section-title--spread">
          <span>MCP List</span>
          <%= link_to "Add MCP", user_company_ai_admin_new_mcp_path(user_id: "me"), class: "action-btn action-btn--small primary" %>
        </div>
        <p class="settings-section-copy">Manage MCP endpoints and credentials.</p>

        <% if @mcps.any? %>
          <div class="bot-selection-grid profile-list-grid mcp-list-grid">
            <% @mcps.each do |mcp| %>
              <article class="bot-card profile-list-card mcp-list-card" data-mcp-card-name="<%= mcp.name %>">
                <div class="profile-list-card__identity">
                  <span class="bot-card-icon" aria-hidden="true">🔌</span>
                  <div class="bot-card-info">
                    <div class="bot-card-name"><%= mcp.name %></div>
                    <div class="bot-card-role">
                      <%= mcp.transport == Mcp::Server::TRANSPORT_STDIO ? mcp.command.to_s.presence || "No command configured" : mcp.url %>
                    </div>
                  </div>
                </div>

                <div class="profile-list-card__meta">
                  <span class="profile-list-card__chip">Transport: <%= mcp.transport %></span>
                  <% if mcp.transport == Mcp::Server::TRANSPORT_STDIO %>
                    <span class="profile-list-card__chip"><%= mcp.args.present? ? "Args set" : "Args missing" %></span>
                    <span class="profile-list-card__chip"><%= mcp.environment.present? ? "Env set" : "No env" %></span>
                  <% else %>
                    <span class="profile-list-card__chip">Auth: <%= mcp.authentication %></span>
                    <span class="profile-list-card__chip"><%= mcp.bearer_token.present? ? "Token set" : "No token" %></span>
                  <% end %>
                  <span class="profile-list-card__chip">Status: <%= mcp.status %></span>
                </div>

                <div class="mcp-list-card__actions">
                  <%= link_to "Edit", user_company_ai_admin_edit_mcp_path(user_id: "me", id: mcp.id), class: "action-btn action-btn--small" %>
                  <%= button_to "Delete", user_company_ai_admin_mcp_destroy_path(user_id: "me", id: mcp.id), method: :delete, class: "action-btn action-btn--small" %>
                </div>
              </article>
            <% end %>
          </div>
        <% else %>
          <p class="company-cell-muted">No MCPs found yet.</p>
        <% end %>
      </section>
    </div>
  </div>
</div>
  </main>
</div>
