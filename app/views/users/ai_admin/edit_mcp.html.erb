<% @page_title = "AI Config - Edit MCP" %>
<% @body_class = "sidebar" %>

<% content_for :nav do %>
  <span class="btn btn--reversed btn--faux user-settings-nav__pill bg-black">Workspace</span>
  <h1 class="user-settings-nav__title txt-large">Edit MCP</h1>
<% end %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<div id="message-area" class="message-area">
  <div class="feed-container company-settings-feed">
    <div class="settings-container">
      <%= render "users/ai_admin/top_links", active_tab: :mcps %>

      <section class="settings-card" aria-label="Edit MCP form">
        <div class="settings-section-title settings-section-title--spread">
          <span>Edit MCP</span>
          <%= link_to "Back to MCP list", user_company_ai_admin_mcps_page_path(user_id: "me"), class: "action-btn action-btn--small" %>
        </div>

        <%= render "users/ai_admin/mcp_form",
            mcp: @mcp,
            form_url: user_company_ai_admin_mcp_path(user_id: "me", id: @mcp.id),
            form_method: :patch,
            submit_label: "Save MCP" %>
      </section>
    </div>
  </div>
</div>
