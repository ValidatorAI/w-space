<div class="list-item <%= "resolved" if attention_item.resolved? %>"
     id="<%= dom_id(attention_item) %>"
     data-home-attention-target="item"
     data-overdue="<%= attention_item.overdue? %>"
     data-ai-confirm="<%= attention_item.ai_confirm? %>">
  <div class="list-item-main-row">
    <span class="list-item-title"><%= attention_item.title %></span>
    <% if attention_item.room_id.present? || attention_item.project_id.present? || attention_item.user_id.present? %>
      <span class="badge gray list-item-tag"><%= attention_item.location_label %></span>
    <% end %>
  </div>
  <% if attention_item.meta_text.present? %>
    <span class="list-item-meta"><%= attention_item.meta_text %></span>
  <% end %>
  <div class="action-btn-group">
    <% if attention_item.pending? %>
      <button class="action-btn primary home-resolve-btn"
              type="button"
              data-action="click->home-attention#resolve"
              data-resolve-url="<%= resolve_attention_item_path(attention_item) %>">
        <%= attention_item.effective_action_label %>
      </button>

      <% if attention_item.target_type == "company_status" %>
        <%= link_to "View Company Status", user_company_status_path(user_id: "me"), class: "action-btn nav-btn" %>
      <% elsif attention_item.target_type == "project_status" && attention_item.project_id.present? %>
        <%= link_to "Open Project Status", user_company_project_status_path(user_id: "me", id: attention_item.project_id), class: "action-btn nav-btn" %>
      <% elsif attention_item.target_type == "project_knowledge" && attention_item.project_id.present? %>
        <%= link_to "Open Knowledge", user_company_project_knowledge_path(user_id: "me", id: attention_item.project_id), class: "action-btn nav-btn" %>
      <% elsif attention_item.target_type == "room" && attention_item.room.present? %>
        <%= link_to "Open Room", room_path(attention_item.room), class: "action-btn nav-btn" %>
      <% end %>
    <% else %>
      <span class="badge gray">Resolved</span>
    <% end %>
  </div>
</div>
