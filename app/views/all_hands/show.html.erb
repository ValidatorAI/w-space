<div style="width: 100%; height: 100vh; margin: 0; padding: 0; overflow: hidden; background: #0f172a; color: white; font-family: system-ui, sans-serif;">
  <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; background: rgba(15, 23, 42, 0.96); border-bottom: 1px solid rgba(148, 163, 184, 0.2);">
    <div>
      <div style="font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: #cbd5e1;">All Hands</div>
      <div style="font-size: 18px; font-weight: 600;"><%= @meeting.title %></div>
    </div>
    <%= link_to "Back to project", user_company_project_all_hands_path(user_id: "me", id: @meeting.project_id), style: "color: white; text-decoration: none; background: rgba(148,163,184,0.15); padding: 8px 12px; border-radius: 8px;" %>
  </div>

  <iframe src="<%= @iframe_src %>" title="<%= @meeting.title %> meeting" style="width: 100%; height: calc(100vh - 70px); border: 0; display: block; background: #020817;"></iframe>
</div>
