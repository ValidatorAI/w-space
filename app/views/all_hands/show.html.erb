<% target_url = (@target_url.presence || user_company_project_all_hands_path(user_id: "me", id: @meeting.project_id)).to_s %>

<div style="width: 100%; height: 100vh; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; background: #0f172a; color: white; font-family: system-ui, sans-serif;">
  <div style="text-align: center; max-width: 520px; padding: 20px;">
    <h2 style="margin-bottom: 12px; font-size: 28px;">Redirecting to meeting...</h2>
    <p style="margin: 0 0 20px; color: #cbd5e1;">You are being taken to the live BigBlueButton session.</p>
    <%= link_to "Open meeting now", target_url, target: "_blank", rel: "noopener", data: { turbo: false }, style: "display: inline-block; background: #2563eb; color: white; text-decoration: none; padding: 10px 18px; border-radius: 8px; font-weight: 600;" %>
  </div>
  <div id="bbb-meeting-target" data-url="<%= h(target_url) %>" style="display: none;"></div>
</div>

<%= javascript_tag nonce: true do %>
  const meetingTargetUrl = document.getElementById("bbb-meeting-target")?.dataset.url || "<%= j(target_url) %>";
  console.log("BigBlueButton meeting URL:", meetingTargetUrl);
  window.location.href = meetingTargetUrl;
<% end %>
