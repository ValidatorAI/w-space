<% @page_title = room_display_name(@room) %>
<% @body_class = "room-shell" %>
<% content_for :head do %>
  <%= turbo_exempts_page_from_preview %>
  <meta name="current-room-id" content="<%= @room.id %>">
<% end %>

<%= render "rooms/show/nav", room: @room %>

<div class="workspace-room"
     data-controller="room-shell"
     data-room-shell-default-tab-value="conversation"
     data-action="click->room-shell#closeWorkspaceIfOpen">
  <aside id="workspace-navigation" class="workspace-room__workspace" data-room-shell-target="workspace" aria-label="Workspace navigation">
    <%= sidebar_turbo_frame_tag(src: user_sidebar_path) %>
  </aside>

  <main class="workspace-room__main" id="conversation">
    <% breadcrumb_items = [] %>
    <% if @room_project.present? %>
      <% breadcrumb_items << @room_project.display_name %>
      <% breadcrumb_items << room_display_name(@room.parent) if @room.parent.present? %>
    <% elsif @room.direct? %>
      <% breadcrumb_items << "Direct room" %>
    <% else %>
      <% breadcrumb_items << "Workspace" %>
    <% end %>
    <% breadcrumb_items << room_display_name(@room) %>

    <header class="workspace-room__header">
      <div class="workspace-room__heading">
        <p class="workspace-room__breadcrumb"><%= breadcrumb_items.join(" > ") %></p>
        <div class="workspace-room__title-row">
          <h1><%= room_display_name(@room) %></h1>
          <% if @open_decision_requests.any? %>
            <span class="workspace-room__state-chip">Needs a decision</span>
          <% elsif @room.child_topics.any? %>
            <span class="workspace-room__state-chip workspace-room__state-chip--neutral">Has active topics</span>
          <% else %>
            <span class="workspace-room__state-chip workspace-room__state-chip--neutral">Room in progress</span>
          <% end %>
        </div>
        <p>
          <% if @room_project&.description.present? %>
            <%= @room_project.description %>
          <% elsif @room.direct? %>
            Keep discussion focused and capture decisions with clear ownership.
          <% else %>
            Use this room to coordinate work, capture decisions, and keep context linked to source material.
          <% end %>
        </p>
      </div>

      <div class="workspace-room__header-actions">
        <button type="button"
                class="btn workspace-room__quiet-btn workspace-room__mobile-nav"
                aria-controls="workspace-navigation"
                aria-expanded="false"
                data-room-shell-target="workspaceToggle"
                data-action="room-shell#toggleWorkspace">
          Menu
        </button>
        <button type="button"
                class="btn workspace-room__quiet-btn"
                aria-controls="room-context-rail"
                aria-expanded="true"
                data-room-shell-target="contextToggle"
                data-action="room-shell#toggleContext">
          Context
        </button>
      </div>
    </header>

    <div class="workspace-room__tabs" role="tablist" aria-label="Room views">
      <button type="button"
              role="tab"
              class="workspace-room__tab"
              aria-selected="true"
              data-room-shell-target="tab"
              data-room-shell-tab-param="conversation"
              data-action="room-shell#switchTab">
        Conversation
      </button>
      <button type="button"
              role="tab"
              class="workspace-room__tab"
              aria-selected="false"
              data-room-shell-target="tab"
              data-room-shell-tab-param="decisions"
              data-action="room-shell#switchTab">
        Decisions
        <span><%= @decision_items_count %></span>
      </button>
      <button type="button"
              role="tab"
              class="workspace-room__tab"
              aria-selected="false"
              data-room-shell-target="tab"
              data-room-shell-tab-param="artifacts"
              data-action="room-shell#switchTab">
        Artifacts
        <span><%= @artifact_items_count %></span>
      </button>
    </div>

    <section class="workspace-room__panel workspace-room__panel--conversation"
             role="tabpanel"
             data-room-shell-target="panel"
             data-room-shell-panel="conversation">
      <%= message_area_tag(@room) do %>
        <%= render "messages/template" %>

        <%= messages_tag(@room) do %>
          <%= render "rooms/show/invitation", room: @room %>
          <%= render partial: "messages/message", collection: @messages, cached: true, locals: { parent_room: @room } %>
        <% end %>

        <%= turbo_stream_from @room, :messages %>
        <%= button_to_jump_to_newest_message %>
      <% end %>
    </section>

    <section class="workspace-room__panel workspace-room__panel--alternate"
             role="tabpanel"
             data-room-shell-target="panel"
             data-room-shell-panel="decisions"
             hidden>
      <%= render "rooms/show/decisions_panel", room: @room %>
    </section>

    <section class="workspace-room__panel workspace-room__panel--alternate"
             role="tabpanel"
             data-room-shell-target="panel"
             data-room-shell-panel="artifacts"
             hidden>
      <%= render "rooms/show/artifacts_panel", room: @room %>
    </section>

    <%= render "rooms/show/composer", room: @room %>
  </main>

  <aside class="workspace-room__context"
         id="room-context-rail"
         aria-label="Room context"
         data-room-shell-target="context">
    <%= render "rooms/show/context_rail", room: @room %>
  </aside>
</div>
