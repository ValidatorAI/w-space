<% content_for :nav do %>
  <% workspace_name = room.project&.display_name || "Workspace" %>

  <div class="room-shell-topbar" aria-label="Workspace header">
    <div class="room-shell-topbar__brand">
      <span class="room-shell-topbar__brand-symbol" aria-hidden="true">W</span>
      <span>PWR <strong>WORK</strong></span>
    </div>

    <div class="room-shell-topbar__workspace">
      <span class="room-shell-topbar__dot" aria-hidden="true"></span>
      <span><%= workspace_name %></span>
    </div>

    <%= link_to searches_path, class: "btn room-shell-topbar__search", aria: { label: "Search or ask" } do %>
      <span aria-hidden="true">⌕</span>
      <span>Search or ask W</span>
      <kbd>⌘K</kbd>
    <% end %>

    <div class="room-shell-topbar__end">
      <span class="room-shell-topbar__dot" aria-hidden="true"></span>
      <span>Context updated <%= time_ago_in_words(room.updated_at) %> ago</span>
      <%= avatar_tag(Current.user) %>
    </div>
  </div>
<% end %>
