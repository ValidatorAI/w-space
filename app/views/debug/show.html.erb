<main class="container py-4 debug-page">
  <header class="debug-page__header">
    <div>
      <p class="debug-page__eyebrow">Admin</p>
      <h1>Debug</h1>
    </div>
    <p class="debug-page__subtitle">Debug tools are enabled for admin users.</p>
  </header>

  <section class="debug-projects">
    <% @project_topic_debug.each_value do |debug_data| %>
      <% project = debug_data[:project] %>
      <article class="card debug-project" data-controller="debug-tree">
        <div class="debug-project__header">
          <div>
            <h2 class="h5 debug-project__title"><%= project.display_name %></h2>
            <p class="debug-project__meta">Project ID: <%= project.id %></p>
          </div>

          <button
            type="button"
            class="debug-project__toggle"
            data-debug-tree-target="toggle"
            data-action="click->debug-tree#toggleProject"
            aria-expanded="false"
          >
            Expand
          </button>
        </div>

        <div class="debug-project__body" data-debug-tree-target="panel" hidden>
          <div class="debug-section">
            <h3 class="h6 debug-section__title">Topic tree</h3>

            <% if debug_data[:roots].any? %>
              <ul class="debug-topic-tree">
                <% debug_data[:roots].each do |topic| %>
                  <%= render "topic_tree_node", topic: topic, children_by_parent_id: debug_data[:children_by_parent_id] %>
                <% end %>
              </ul>
            <% else %>
              <p class="debug-empty">No root topics.</p>
            <% end %>
          </div>

          <div class="debug-section">
            <h3 class="h6 debug-section__title">Anomalies</h3>

            <% if debug_data[:anomaly_entries].any? %>
              <ul class="debug-anomalies">
                <% debug_data[:anomaly_entries].each do |entry| %>
                  <li class="debug-anomaly">
                    <strong><%= entry[:topic].name %></strong>
                    (id=<%= entry[:topic].id %>, parent_id=<%= entry[:topic].parent_topic_id || "nil" %>)
                    - <%= entry[:reasons].join("; ") %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="debug-empty">No anomalies detected.</p>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
  </section>
</main>
